        "/health/readiness": {
            "get": {
                "operationId": "v1.health.readiness",
                "description": "Checks safe application dependencies without contacting external file, notification or payment providers.",
                "summary": "Readiness check",
                "tags": [
                    "Readiness"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "enum": [
                                                        "ready",
                                                        "not_ready"
                                                    ]
                                                },
                                                "checks": {
                                                    "type": "object",
                                                    "properties": {
                                                        "application": {
                                                            "type": "string",
                                                            "enum": [
                                                                "ok",
                                                                "unavailable"
                                                            ]
                                                        },
                                                        "database": {
                                                            "type": "string",
                                                            "enum": [
                                                                "unavailable",
                                                                "ok"
                                                            ]
                                                        },
                                                        "cache": {
                                                            "type": "string",
                                                            "enum": [
                                                                "configured",
                                                                "unavailable"
                                                            ]
                                                        },
                                                        "queue": {
                                                            "type": "string",
                                                            "enum": [
                                                                "configured",
                                                                "unavailable"
                                                            ]
                                                        },
                                                        "storage": {
                                                            "type": "string",
                                                            "enum": [
                                                                "configured",
                                                                "unavailable"
                                                            ]
                                                        }
                                                    },
                                                    "required": [
                                                        "application",
                                                        "database",
                                                        "cache",
                                                        "queue",
                                                        "storage"
                                                    ]
                                                }
