                            "X-Request-ID": {
                                "description": "Request correlation identifier.",
                                "required": true,
                                "schema": {
                                    "type": "string",
                                    "format": "uuid"
                                }
                            }
                        }
                    },
                    "302": {
                        "description": "Redirects to the short-lived signed Cloudinary download URL.",
